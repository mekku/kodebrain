{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodebrain/schema/edge.schema.json",
  "title": "KnowledgeEdge",
  "description": "A directed relationship between two knowledge nodes.",
  "type": "object",
  "required": ["from", "to", "type", "confidence", "provenance"],
  "additionalProperties": false,
  "properties": {
    "from": {
      "type": "string",
      "description": "Source node ID. Must match a node.id in nodes.json."
    },
    "to": {
      "type": "string",
      "description": "Target node ID. Must match a node.id in nodes.json."
    },
    "type": {
      "type": "string",
      "enum": [
        "contains",
        "implements",
        "uses",
        "depends_on",
        "calls",
        "reads_from",
        "writes_to",
        "invalidates",
        "exposes",
        "renders",
        "part_of_flow",
        "replaces",
        "replaced_by",
        "related_to",
        "risky_for",
        "supported_by"
      ],
      "description": "The semantic type of the relationship."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "verified",
        "supported",
        "inferred",
        "ambiguous",
        "needs_human_review"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "human",
        "project_document",
        "source_code",
        "configuration",
        "runtime",
        "test",
        "git",
        "generated"
      ],
      "description": "Where the edge claim originated."
    },
    "evidence": {
      "type": "array",
      "description": "Source evidence supporting this edge. Required when confidence is supported or verified.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "description": "Source file path relative to project root."
          },
          "symbol": {
            "type": "string",
            "description": "Function, class, or constant name."
          },
          "route": {
            "type": "string",
            "description": "HTTP method + path, e.g. 'POST /api/orders'."
          },
          "note": {
            "type": "string",
            "description": "Human-readable explanation of what this evidence shows."
          }
        }
      }
    },
    "label": {
      "type": "string",
      "maxLength": 80,
      "description": "Optional short label for graph visualization."
    },
    "created_by": {
      "type": "string",
      "enum": ["human", "knowledge_builder", "knowledge_architect", "knowledge_reviewer", "generated"],
      "description": "Who created this edge."
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  },
  "examples": [
    {
      "from": "auth-login-capability",
      "to": "auth-login-flow",
      "type": "part_of_flow",
      "confidence": "supported",
      "provenance": "source_code",
      "evidence": [
        {
          "file": "src/api/auth/login.ts",
          "symbol": "loginHandler",
          "note": "Handler directly calls AuthService.validateCredentials and AuthService.createSession in sequence"
        }
      ],
      "created_by": "knowledge_builder",
      "last_updated": "2026-08-07"
    }
  ]
}
