{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodebrain/schema/knowledge-base.schema.json",
  "title": "KnowledgeBase",
  "description": "Top-level container for a project's Kode Brain knowledge map. Stored as nodes.json + edges.json under docs/brain/projects/<name>/graph/.",
  "type": "object",
  "required": ["project", "schema_version", "generated_at", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "description": "Project slug. Matches the directory name under docs/brain/projects/."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version of this knowledge base format. Used for migration detection."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last full generation."
    },
    "generated_by": {
      "type": "string",
      "description": "Agent or tool that last generated this file."
    },
    "last_onboarded": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last onboarding run."
    },
    "onboarding_state": {
      "type": "string",
      "enum": [
        "greenfield",
        "new_brownfield",
        "partial_kb",
        "legacy_kb",
        "stale_kb",
        "onboarded"
      ],
      "description": "Current onboarding state of this project's KB."
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "node.schema.json" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "edge.schema.json" }
    },
    "file_index": {
      "type": "object",
      "description": "Reverse index: source file path to list of node IDs that reference that file.",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "description": "Summary statistics for quick inspection.",
      "additionalProperties": false,
      "properties": {
        "total_nodes": { "type": "number" },
        "total_edges": { "type": "number" },
        "nodes_by_type": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "nodes_by_status": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "nodes_by_confidence": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "unmapped_files": {
          "type": "number",
          "description": "Count of source files not referenced by any node."
        }
      }
    }
  },
  "examples": [
    {
      "project": "admin-platform",
      "schema_version": "1.0",
      "generated_at": "2026-08-07T10:30:00Z",
      "generated_by": "knowledge_builder",
      "last_onboarded": "2026-08-07T10:00:00Z",
      "onboarding_state": "onboarded",
      "nodes": [],
      "edges": [],
      "file_index": {},
      "stats": {
        "total_nodes": 0,
        "total_edges": 0,
        "nodes_by_type": {},
        "nodes_by_status": {},
        "nodes_by_confidence": {},
        "unmapped_files": 0
      }
    }
  ]
}
